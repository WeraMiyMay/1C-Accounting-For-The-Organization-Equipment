
Процедура ОбработкаПроведения(Отказ, Режим)

	// Записываем движения
	Движения.ОстаткиОборудования.Записывать = Истина;

	Если Оборудование.Количество() = 0 Тогда
		Отказ = Истина;
		Сообщить("Документ не содержит оборудования!");
		Возврат;
	КонецЕсли;


	Для Каждого Строка Из Оборудование Цикл

		// --- 1. Проверки ---
		Если Строка.Номенклатура = Неопределено Тогда
			Отказ = Истина;
			Сообщить("Не заполнена номенклатура в строке №" + Строка.НомерСтроки);
			Возврат;
		КонецЕсли;

		Если ПустаяСтрока(Строка.ИнвентарныйНомер) Тогда
			Отказ = Истина;
			Сообщить("Не заполнен инвентарный номер в строке №" + Строка.НомерСтроки);
			Возврат;
		КонецЕсли;

		Если Строка.Стоимость < 0 Тогда
			Отказ = Истина;
			Сообщить("Стоимость не может быть отрицательной!");
			Возврат;
		КонецЕсли;


		// --- 2. Проверка дублей инвентарного номера ---
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|   ИнвентарныеОбъекты.Ссылка
		|ИЗ
		|   Справочник.ИнвентарныеОбъекты КАК ИнвентарныеОбъекты
		|ГДЕ
		|   ИнвентарныеОбъекты.ИнвентарныйНомер = &Номер";

		Запрос.УстановитьПараметр("Номер", Строка.ИнвентарныйНомер);

		Если НЕ Запрос.Выполнить().Пустой() Тогда
			Отказ = Истина;
			Сообщить("Инвентарный номер уже существует: " + Строка.ИнвентарныйНомер);
			Возврат;
		КонецЕсли;


		// --- 3. Создание инвентарного объекта ---
		Попытка

			НовыйОбъект = Справочники.ИнвентарныеОбъекты.СоздатьЭлемент();

			НовыйОбъект.Номенклатура = Строка.Номенклатура;
			НовыйОбъект.ИнвентарныйНомер = Строка.ИнвентарныйНомер;
			НовыйОбъект.СерийныйНомер = Строка.СерийныйНомер;
			НовыйОбъект.ДатаПоступления = Дата;
			НовыйОбъект.Стоимость = Строка.Стоимость;
			НовыйОбъект.ДатаОкончанияГарантии = Строка.ГарантияДо;
			НовыйОбъект.Статус = Перечисления.СтатусОборудования.НаСкладе;

			// Наименование
			НовыйОбъект.Наименование =
				Строка.Номенклатура.Наименование
				+ " №" + Строка.ИнвентарныйНомер;

			НовыйОбъект.Записать();

		Исключение
			Отказ = Истина;
			Сообщить("Ошибка создания инвентарного объекта!");
			Возврат;
		КонецПопытки;


		// --- 4. Движение регистра ---
		Движение = Движения.ОстаткиОборудования.Добавить();

		Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
		Движение.Период = Дата;
		Движение.ИнвентарныйОбъект = НовыйОбъект.Ссылка;
		Движение.Номенклатура = Строка.Номенклатура;
		Движение.Подразделение = Подразделение;
		Движение.Сотрудник = Неопределено;
		Движение.Количество = 1;

	КонецЦикла;
КонецПроцедуры
